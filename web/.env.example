# まなびのわ web 環境変数のひな形。値を入れて .env として保存する。
# 実際の値はコミットしないこと。

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Google (Meet 連携 / Eフロー) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# --- Gemini (D-06 マッチングの意味ベクトル生成) ---
# 未設定でも動作する。その場合は教科・学年の条件一致で候補を出す。
GEMINI_API_KEY=

# --- メール送信 (D-09 / D-12 の通知) ---
# 未設定でも動作する。その場合は送信せず notification_logs に記録するのみ。
RESEND_API_KEY=
MAIL_FROM=
