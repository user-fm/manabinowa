# まなびのわ web 環境変数のひな形。値を入れて .env として保存する。
# 実際の値はコミットしないこと。

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Google (Meet 連携 / Eフロー) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# --- Gemini (D-06 マッチングの意味ベクトル生成 / H-03 チャットのAI監視) ---
# 未設定でも動作する。マッチングは教科・学年の条件一致、
# AI監視は禁止語パターンによる簡易検知にフォールバックする。
GEMINI_API_KEY=
# 監視に使うモデル。未設定なら gemini-2.5-flash
GEMINI_MODEL=

# --- AI監視の一括検査API (H-02) ---
# POST /api/moderation を外部cronから叩くための共有シークレット。
# 未設定の場合、このエンドポイントは 503 を返して無効になる。
MODERATION_CRON_SECRET=

# --- メール送信 (D-09 / D-12 の通知) ---
# 未設定でも動作する。その場合は送信せず notification_logs に記録するのみ。
RESEND_API_KEY=
MAIL_FROM=
